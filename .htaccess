# Pasar el header Authorization a PHP (necesario para el token Bearer)
CGIPassAuth On
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Bloquear archivos de desarrollo/empaquetado que no deben ser públicos
# (sin directivas "Require": interfieren con el header Authorization)
RedirectMatch 404 ^/(android|docs|node_modules|www|\.git|\.claude)(/|$)
RedirectMatch 404 ^/(package(-lock)?\.json|capacitor\.config\.json|config\.php|test\.php|index_2\.html)$
RedirectMatch 404 \.(sql|md)$
